{% extends "@vactory_dashboard/_layout/main-content-layout.html.twig" %}

{% block content %}
  <script type="application/json" id="block-regions-config">
    {{ {
      theme: dashboard_theme,
      regions: regions,
      blocks: blocks,
      save_url: path('vactory_dashboard.block_regions.save'),
      available_url: path('vactory_dashboard.block_regions.available'),
      place_url: path('vactory_dashboard.block_regions.place'),
      remove_url: path('vactory_dashboard.block_regions.remove'),
    }|json_encode|raw }}
  </script>

  <div x-data="blockRegionsManager()">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold text-slate-900">{{ 'Block layout'|t }}</h1>
      <button type="button"
              @click="save()"
              :disabled="isSaving"
              :class="{ 'opacity-50 cursor-not-allowed': isSaving }"
              class="inline-flex items-center gap-x-2 rounded-lg bg-primary-500 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-600">
        <svg x-show="isSaving" class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span x-text="isSaving ? '{{ 'Saving...'|t|e('js') }}' : '{{ 'Save'|t|e('js') }}'"></span>
      </button>
    </div>

    {# Tabs #}
    <div class="mb-6 border-b border-slate-200 bg-white">
      <nav class="-mb-px flex overflow-auto">
        <a href="{{ path('vactory_dashboard.block_content') }}"
           class="border-b-2 border-transparent px-4 py-4 text-sm font-medium text-slate-500 hover:text-slate-700 hover:border-slate-300">
          {{ 'Content blocks'|t }}
        </a>
        <button type="button"
                class="border-b-2 border-primary-500 px-4 py-4 text-sm font-medium text-primary-600">
          {{ 'Block layout'|t }}
        </button>
      </nav>
    </div>

    {# Notification #}
    <div x-show="notification.show" x-transition x-cloak
         :class="notification.type === 'success' ? 'bg-green-50 text-green-800 border-green-200' : 'bg-red-50 text-red-800 border-red-200'"
         class="mb-4 rounded-lg border px-4 py-3 text-sm">
      <span x-text="notification.message"></span>
    </div>

    {# Regions #}
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      <template x-for="region in regions" :key="region.machine">
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm"
             @dragover.prevent="dragOverRegion = region.machine"
             @drop.prevent="dropOnRegion(region.machine)"
             :class="dragOverRegion === region.machine ? 'ring-2 ring-primary-400' : ''">
          <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-semibold text-slate-900" x-text="region.label"></h3>
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500"
                    x-text="(blocks[region.machine] || []).length"></span>
            </div>
            <button type="button"
                    @click="openPlaceModal(region.machine)"
                    class="inline-flex items-center gap-1 rounded-md border border-primary-200 bg-primary-50 px-2.5 py-1 text-xs font-semibold text-primary-700 hover:bg-primary-100">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              {{ 'Place block'|t }}
            </button>
          </div>

          <div class="min-h-[3rem] space-y-2 p-3">
            <template x-if="!(blocks[region.machine] || []).length">
              <p class="py-2 text-center text-xs italic text-slate-400">{{ 'Drop blocks here'|t }}</p>
            </template>

            <template x-for="(block, index) in (blocks[region.machine] || [])" :key="block.id">
              <div draggable="true"
                   @dragstart="onDragStart(region.machine, index)"
                   @dragover.prevent
                   @drop.prevent.stop="dropOnBlock(region.machine, index)"
                   class="flex cursor-move items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 hover:bg-slate-100"
                   :class="!block.status ? 'opacity-50' : ''">
                <div class="flex min-w-0 items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 9h8M8 15h8"/>
                  </svg>
                  <span class="truncate text-sm text-slate-800" x-text="block.label"></span>
                </div>
                <div class="flex shrink-0 items-center gap-3">
                  <label class="flex items-center gap-1 text-xs text-slate-500" @dragstart.stop>
                    <input type="checkbox" x-model="block.status"
                           class="h-3.5 w-3.5 rounded border-slate-300 text-primary-600 focus:ring-primary-500">
                    {{ 'Enabled'|t }}
                  </label>
                  <button type="button"
                          @click="removeBlock(region.machine, index)"
                          @dragstart.stop
                          :title="'{{ 'Remove'|t|e('js') }}'"
                          class="rounded p-1 text-red-500 hover:bg-red-50 hover:text-red-700">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>

    {# Place block modal (block library) #}
    <div x-show="showPlaceModal" x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center p-4"
         @keydown.escape.window="showPlaceModal = false">
      <div class="absolute inset-0 bg-slate-900/50" @click="showPlaceModal = false"></div>
      <div class="relative flex max-h-[90vh] w-full max-w-2xl flex-col rounded-xl bg-white shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
          <h3 class="text-base font-semibold text-slate-900">
            {{ 'Place block in'|t }} "<span x-text="regionLabel(placeRegion)"></span>"
          </h3>
          <button type="button" @click="showPlaceModal = false" class="text-slate-400 hover:text-slate-600">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="border-b border-slate-100 px-5 py-3">
          <input type="search" x-model="placeSearch"
                 placeholder="{{ 'Filter by block name...'|t }}"
                 class="block w-full rounded-md border-0 py-2 px-3 text-sm text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-inset focus:ring-primary-500">
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto p-3">
          <template x-if="loadingAvailable">
            <p class="py-6 text-center text-sm text-slate-400">{{ 'Loading...'|t }}</p>
          </template>
          <template x-if="!loadingAvailable && filteredAvailable().length === 0">
            <p class="py-6 text-center text-sm text-slate-400">{{ 'No blocks found'|t }}</p>
          </template>
          <template x-for="item in filteredAvailable()" :key="item.plugin_id">
            <button type="button"
                    @click="placeBlock(item)"
                    :disabled="isPlacing"
                    class="flex w-full items-center justify-between gap-2 rounded-lg px-3 py-2 text-left hover:bg-slate-50 disabled:opacity-50">
              <div class="min-w-0">
                <div class="truncate text-sm font-medium text-slate-800" x-text="item.label"></div>
                <div class="truncate text-xs text-slate-400" x-text="item.category"></div>
              </div>
              <span class="shrink-0 text-xs font-semibold text-primary-600">{{ 'Place'|t }}</span>
            </button>
          </template>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.data('blockRegionsManager', () => {
        const readConfig = () => {
          const el = document.getElementById('block-regions-config');
          try { return JSON.parse(el.textContent); } catch (e) { return {}; }
        };
        const config = readConfig();
        // Normalize regions { machine: label } -> [{ machine, label }].
        const regions = Object.entries(config.regions || {}).map(([machine, label]) => ({ machine, label }));

        return {
          theme: config.theme,
          saveUrl: config.save_url,
          availableUrl: config.available_url,
          placeUrl: config.place_url,
          removeUrl: config.remove_url,
          regions: regions,
          blocks: config.blocks || {},
          dragged: null,
          dragOverRegion: null,
          isSaving: false,
          notification: { show: false, type: 'success', message: '' },
          // Place block modal state.
          showPlaceModal: false,
          placeRegion: null,
          placeSearch: '',
          availableBlocks: [],
          loadingAvailable: false,
          isPlacing: false,

          regionLabel(machine) {
            const r = this.regions.find((x) => x.machine === machine);
            return r ? r.label : machine;
          },

          async openPlaceModal(region) {
            this.placeRegion = region;
            this.placeSearch = '';
            this.showPlaceModal = true;
            if (this.availableBlocks.length === 0) {
              this.loadingAvailable = true;
              try {
                const response = await fetch(this.availableUrl);
                const data = await response.json();
                this.availableBlocks = data.data || [];
              } catch (e) {
                this.availableBlocks = [];
              } finally {
                this.loadingAvailable = false;
              }
            }
          },

          filteredAvailable() {
            const q = this.placeSearch.trim().toLowerCase();
            if (!q) {
              return this.availableBlocks;
            }
            return this.availableBlocks.filter((b) =>
              b.label.toLowerCase().includes(q) || b.category.toLowerCase().includes(q));
          },

          async placeBlock(item) {
            if (this.isPlacing) {
              return;
            }
            this.isPlacing = true;
            try {
              const response = await fetch(this.placeUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ plugin_id: item.plugin_id, region: this.placeRegion }),
              });
              const data = await response.json();
              if (response.ok && data.block) {
                this.blocks[this.placeRegion] = this.blocks[this.placeRegion] || [];
                this.blocks[this.placeRegion].push(data.block);
                this.showPlaceModal = false;
                this.notify('success', data.message);
              } else {
                this.notify('error', data.message || '{{ 'An error occurred.'|t|e('js') }}');
              }
            } catch (e) {
              this.notify('error', '{{ 'An error occurred.'|t|e('js') }}');
            } finally {
              this.isPlacing = false;
            }
          },

          async removeBlock(region, index) {
            const list = this.blocks[region] || [];
            const block = list[index];
            if (!block || !window.confirm('{{ 'Remove this block from the layout?'|t|e('js') }}')) {
              return;
            }
            try {
              const response = await fetch(this.removeUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: block.id }),
              });
              const data = await response.json();
              if (response.ok) {
                list.splice(index, 1);
                this.notify('success', data.message);
              } else {
                this.notify('error', data.message || '{{ 'An error occurred.'|t|e('js') }}');
              }
            } catch (e) {
              this.notify('error', '{{ 'An error occurred.'|t|e('js') }}');
            }
          },

          notify(type, message) {
            this.notification = { show: true, type: type, message: message };
          },

          onDragStart(region, index) {
            this.dragged = { region, index };
          },

          moveTo(targetRegion, targetIndex) {
            if (!this.dragged) {
              return;
            }
            const { region: fromRegion, index: fromIndex } = this.dragged;
            this.blocks[fromRegion] = this.blocks[fromRegion] || [];
            this.blocks[targetRegion] = this.blocks[targetRegion] || [];

            const [item] = this.blocks[fromRegion].splice(fromIndex, 1);
            if (!item) {
              this.dragged = null;
              return;
            }
            item.region = targetRegion;

            // Adjust insertion index if moving within the same region after removal.
            let insertAt = targetIndex;
            if (insertAt === null || insertAt === undefined) {
              insertAt = this.blocks[targetRegion].length;
            }
            else if (fromRegion === targetRegion && fromIndex < insertAt) {
              insertAt = insertAt - 1;
            }
            this.blocks[targetRegion].splice(insertAt, 0, item);
            this.dragged = null;
            this.dragOverRegion = null;
          },

          dropOnRegion(targetRegion) {
            this.moveTo(targetRegion, null);
          },

          dropOnBlock(targetRegion, targetIndex) {
            this.moveTo(targetRegion, targetIndex);
          },

          buildPlacements() {
            const placements = [];
            this.regions.forEach((region) => {
              (this.blocks[region.machine] || []).forEach((block, index) => {
                placements.push({
                  id: block.id,
                  region: region.machine,
                  weight: index,
                  status: !!block.status,
                });
              });
            });
            return placements;
          },

          async save() {
            this.isSaving = true;
            this.notification.show = false;
            try {
              const response = await fetch(this.saveUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ placements: this.buildPlacements() }),
              });
              const data = await response.json();
              this.notification = {
                show: true,
                type: response.ok ? 'success' : 'error',
                message: data.message || (response.ok ? '{{ 'Saved.'|t|e('js') }}' : '{{ 'An error occurred.'|t|e('js') }}'),
              };
            } catch (error) {
              this.notification = { show: true, type: 'error', message: '{{ 'An error occurred.'|t|e('js') }}' };
            } finally {
              this.isSaving = false;
            }
          },
        };
      });
    });
  </script>
{% endblock %}
