<?php

/**
 * @file
 * Install script for vactory_dashboard module.
 */

use Drupal\user\Entity\Role;
use Drupal\block\Entity\Block;
use Drupal\block_content\Entity\BlockContent;

/**
 * Implements hook_update_dependencies().
 *
 * Until update 9971 has removed the unusable "slug" field from the dashboard
 * search index, any update that saves a view or the index fails with
 * search_api 1.43 ("Could not retrieve data definition for field 'Term slug'").
 * Updates of other modules can run before 9971 (Redmine #71716): every pending
 * update of another module waits for it.
 */
function vactory_dashboard_update_dependencies() {
  $registry = \Drupal::service('update.update_hook_registry');
  if ($registry->getInstalledVersion('vactory_dashboard') >= 9971) {
    return [];
  }
  $dependencies = [];
  $module_handler = \Drupal::moduleHandler();
  foreach (array_keys($module_handler->getModuleList()) as $module) {
    if ($module === 'vactory_dashboard') {
      continue;
    }
    // The update functions of a module are found only once its .install file
    // is loaded.
    $module_handler->loadInclude($module, 'install');
    $installed = $registry->getInstalledVersion($module);
    foreach ($registry->getAvailableUpdates($module) as $number) {
      if ($number > $installed) {
        $dependencies[$module][$number]['vactory_dashboard'] = 9971;
      }
    }
  }
  return $dependencies;
}

/**
 * Assign permissions (access dash, sitemap, media ..) to webmaster.
 */
function vactory_dashboard_update_9956() {
  _assign_permissions_to_webmaster();
}

/**
 * Assign permissions (access dash, sitemap, media ..) to webmaster.
 */
function vactory_dashboard_update_9970() {
  _assign_permissions_to_webmaster();
  _create_tourguide_block();
}

/**
 * Removes the term "slug" field from the dashboard search index when unusable.
 *
 * The field reads a property provided by vactory_decoupled. On a site without
 * it, search_api cannot load the field definition; since search_api 1.43 the
 * error is no longer only logged, and saving a view or the index fails (seen
 * during "drush updb"). The field and its references in the processors are
 * removed only when its definition cannot be loaded: decoupled sites keep it.
 */
function vactory_dashboard_update_9971() {
  if (!\Drupal::moduleHandler()->moduleExists('search_api')) {
    return t('search_api is not enabled: nothing to do.');
  }
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('vactory_dashboard_search');
  $field = $index ? $index->getField('slug') : NULL;
  if (!$field) {
    return t('No "slug" field on the dashboard search index: nothing to do.');
  }
  try {
    $field->getDataDefinition();
    return t('The "slug" field of the dashboard search index is usable: kept.');
  }
  catch (\Exception $e) {
    // The property is not available on this site: remove the field below.
  }
  $index->removeField('slug');
  foreach ($index->getProcessors() as $processor) {
    $configuration = $processor->getConfiguration();
    if (!empty($configuration['fields']) && in_array('slug', $configuration['fields'], TRUE)) {
      $configuration['fields'] = array_values(array_diff($configuration['fields'], ['slug']));
      $processor->setConfiguration($configuration);
    }
  }
  $index->save();
  return t('Unusable "slug" field removed from the dashboard search index.');
}

/**
 * Implements hook_install().
 */
function vactory_dashboard_install() {
  _assign_permissions_to_webmaster();
}

/**
 * Assign the permissions such as (access dashboard, access webform overview ...) to webmaster role.
 */
function _assign_permissions_to_webmaster() {
  $role = Role::load('webmaster');

  if ($role) {
    $role->grantPermission('access dashboard');
    $role->grantPermission('access drupal advanced mode');
    $role->grantPermission('administer content translation');
    $role->grantPermission('access sitemap');
    $role->grantPermission('access webform overview');
    $role->grantPermission('administer block content');
    $role->grantPermission('access user profiles');
    $role->grantPermission('view media');
    $role->grantPermission('access content overview');
    $role->grantPermission('access taxonomy overview');
    $role->grantPermission('administer users');
    $role->grantPermission('administer dashboard configuration');
    $role->save();
  }
}

/**
 * Implements hook_uninstall().
 */
function vactory_dashboard_uninstall() {
  $config_factory = \Drupal::configFactory();

  $config_factory->getEditable('search_api.index.vactory_dashboard_search')->delete();
}

/**
 * Creates a new block content and add to the main section of vactory_admin theme.
 */
function _create_tourguide_block() {
  $widget_data['extra_field']['next_btn'] = 'Next';
  $widget_data['extra_field']['prev_btn'] = 'Previous';
  $widget_data['extra_field']['skip_btn'] = 'Skip';
  $widget_data['extra_field']['end_btn'] = 'Finish';
  $widget_data['extra_field']['tourguide_id'] = 'homepage';
  $widget_data['extra_field']['show_time'] = '1';

  $block_content = BlockContent::create([
    'type' => 'vactory_block_component',
    'info' => 'Tour Guide',
    'block_machine_name' => 'vactory_dashboard_tour_guide',
    'field_dynamic_block_components' => [
      'widget_id' => 'vactory_dashboard:tour-guide',
      'widget_data' => json_encode($widget_data),
    ],
  ]);
  $block_content->save();

  $block = Block::create([
    'id' => 'vactory_dashboard_tour_guide',
    'plugin' => 'block_content:' . $block_content->get('uuid')->value,
    'region' => 'content',
    'theme' => 'vactory_admin',
    'status' => TRUE,
    'settings' => [
      'label' => 'Vactory Dashboard Tour guide',
      'label_display' => FALSE,
    ],
    'visibility' => [],
  ]);

  $block->save();
}